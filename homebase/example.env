# Copy this file to "settings.env" in the same folder, then fill it in.
# Lines starting with # are notes and get ignored.

# The NAS folders to search, separated by commas.
# Windows: use the network path, the same thing you'd type in File Explorer's address bar.
NAS_ROOTS=\\DS418\Documents,\\DS418\Scans
# Mac: shares show up under /Volumes once connected in Finder, e.g.
# NAS_ROOTS=/Volumes/Documents,/Volumes/Scans

# Your timezone (list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
# Examples: Australia/Sydney, Europe/London, America/New_York
TIMEZONE=Australia/Sydney

# The address you open the app at: this PC's Tailscale https address.
# Example: https://gaming-pc.tail1234.ts.net
BASE_URL=https://your-pc.your-tailnet.ts.net

# Ollama runs on this same PC, so this usually stays as is.
OLLAMA_URL=http://127.0.0.1:11434
# The model you pulled (see README). Must support tool calling.
OLLAMA_MODEL=qwen2.5:7b
# How much conversation the model can see at once. Raise it if your GPU has room.
OLLAMA_NUM_CTX=8192

# How many accounts can be created (you and your wife = 2)
MAX_USERS=2

# Background jobs, in hours. 0 turns one off.
INDEX_EVERY_HOURS=6
BILL_SCAN_EVERY_HOURS=12
# How far back to look in email for bills, in days
BILL_SCAN_DAYS=45

# Skip reading the inside of files bigger than this (they're still searchable by name)
MAX_FILE_MB=25

ASSISTANT_NAME=Homebase
