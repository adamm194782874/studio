# Copy this file to "settings.env" in the same folder, then fill it in.
# Lines starting with # are notes and get ignored.

# The NAS folders to search, separated by commas.
# Mac: shares show up under /Volumes once connected in Finder (see README Step 1).
NAS_ROOTS=/Volumes/Documents,/Volumes/Scans
# Windows: use network paths instead, e.g.
# NAS_ROOTS=\\DS418\Documents,\\DS418\Scans

# Your timezone (list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
# Examples: Australia/Sydney, Europe/London, America/New_York
TIMEZONE=Australia/Sydney

# The address you open the app at: this computer's Tailscale https address.
# Example: https://adams-imac.tail1234.ts.net
BASE_URL=https://your-imac.your-tailnet.ts.net

# Ollama runs on this same computer, so this usually stays as is.
OLLAMA_URL=http://127.0.0.1:11434

# The AI model. On an Intel Mac (no Apple chip), start small:
#   qwen2.5:3b   faster, a bit less clever (recommended to start)
#   qwen2.5:7b   smarter, roughly twice as slow, needs 16GB of memory
# On an Apple chip Mac or a PC with a good graphics card, use qwen2.5:7b or bigger.
OLLAMA_MODEL=qwen2.5:3b

# How much the model can "see" at once. Smaller is faster and uses less memory.
OLLAMA_NUM_CTX=6144
# How many past messages it remembers in a chat. Fewer is faster.
HISTORY_TURNS=6
# Keep the model loaded this long after the last question (loading it again is slow).
OLLAMA_KEEP_ALIVE=4h

# How many accounts can be created (you and your wife = 2)
MAX_USERS=2

# Background jobs, in hours. 0 turns one off.
INDEX_EVERY_HOURS=6
BILL_SCAN_EVERY_HOURS=12
# How far back to look in email for bills, in days
BILL_SCAN_DAYS=45

# Skip reading the inside of files bigger than this (they're still searchable by name)
MAX_FILE_MB=25

ASSISTANT_NAME=Homebase
