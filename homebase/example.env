# Copy this file to "settings.env" in the same folder, then fill it in.

# Your timezone (list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TZ=America/New_York

# The address you open the app at. Use your Tailscale https address so Google sign in works.
# Example: https://ds418.tail1234.ts.net
BASE_URL=https://ds418.your-tailnet.ts.net

# The PC running Ollama. Give that PC a fixed IP in your router.
OLLAMA_URL=http://192.168.1.50:11434
# Pick a model your PC can handle (see README). Must support tool calling.
OLLAMA_MODEL=qwen2.5:7b
# How much conversation the model can see at once. Raise if your GPU has room.
OLLAMA_NUM_CTX=8192

# Folders inside the container to index. These match the right side of the volumes in docker-compose.yml.
NAS_ROOTS=/nas

# How many accounts can be created (you and your wife = 2)
MAX_USERS=2

# Background jobs, in hours. 0 turns one off.
INDEX_EVERY_HOURS=6
BILL_SCAN_EVERY_HOURS=12
# How far back to look in email for bills, in days
BILL_SCAN_DAYS=45

# Skip reading the inside of files bigger than this (still searchable by name)
MAX_FILE_MB=25

ASSISTANT_NAME=Homebase
